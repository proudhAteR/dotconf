{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "NetHydra",
        "color": {
            "1": "white"
        },
        "padding": {
            "top": 6
        }
    },
    "display": {
        "color": {
            "keys": "white"
        },
        "separator": " ",
        "key": {
            "width": 15
        },
        "constants": [
            "─────────────────────────────────────"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;5;8m┌{$1}┐",
            "outputColor": "white"
        },
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠  ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭  ",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "└ └󰋊  ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;8m└{$1}┘",
            "outputColor": "white"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;5;8m┌{$1}┐",
            "outputColor": "white"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗  ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "└ └󰞷  ",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "wm",
            "key": "│ ├󱂬  ",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦  ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍  ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;8m└{$1}┘",
            "outputColor": "white"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;5;8m┌{$1}┐",
            "outputColor": "white"
        },
        {
            "type": "localip",
            "key": " › IP ",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": " › Uptime ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": " › DateTime ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;8m└{$1}┘",
            "outputColor": "white"
        },
        "break",
        {
            "type": "colors",
            "symbol": "block"
        }
    ]
}
